{
    "Routes": [
        {
            "DownstreamPathTemplate": "/api/auth/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "identity-api",
                    "Port": 8080
                }
            ],
            "UpstreamPathTemplate": "/auth/{everything}",
            "UpstreamHttpMethod": [
                "GET",
                "POST",
                "PUT",
                "DELETE"
            ]
        },
        {
            "DownstreamPathTemplate": "/api/cases/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "cases-api",
                    "Port": 8080
                }
            ],
            "UpstreamPathTemplate": "/cases/{everything}",
            "UpstreamHttpMethod": [
                "GET",
                "POST",
                "PUT",
                "DELETE"
            ]
        }
    ],
    "GlobalConfiguration": {
        "BaseUrl": "http://localhost:5000"
    }
}